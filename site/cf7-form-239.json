  "form": "<div class=\"abex-cf7-grid\">\n<div class=\"abex-f abex-f--full\"><label>Your name*\n[text* your-name autocomplete:name placeholder \"Write your name here\"]</label></div>\n<div class=\"abex-f\"><label>Your email*\n[email* your-email autocomplete:email placeholder \"Write your email\"]</label></div>\n<div class=\"abex-f\"><label>Your phone\n[tel your-phone autocomplete:tel placeholder \"Write your phone number\"]</label></div>\n<div class=\"abex-f abex-f--full\"><label>Company\n[text your-company autocomplete:organization placeholder \"Your organisation\"]</label></div>\n<div class=\"abex-f abex-f--full\"><label>Message\n[textarea your-message x4 placeholder \"Tell us about your project or business\"]</label></div>\n</div>\n[submit class:abex-cf7-submit \"Send message\"]",
  "mail": {
    "recipient": "test@gmail.com (test address on purpose; change before launch)",
    "subject": "Website enquiry from [your-name]",
    "reply_to": "[your-name] <[your-email]>"
